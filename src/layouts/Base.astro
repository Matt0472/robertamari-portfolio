---
import { withBase } from '../lib/paths';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import displayFont from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSection } from '../lib/content';
import { plainText } from '../lib/emphasis';
import { resolveImage } from '../lib/images';
import { isIndexable } from '../lib/indexing';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const settings = await getSection('settings');
const book = await getSection('book');
const award = await getSection('award');

const { title, description = settings.seo_description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${settings.name}` : [settings.name, settings.role].filter(Boolean).join(' · ');
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;

const coverSource = resolveImage(book.cover);
const cover = coverSource
  ? await getImage({ src: coverSource, width: Math.min(coverSource.width, 800), format: 'jpg', quality: 82 })
  : undefined;
const coverUrl = cover ? new URL(cover.src, site).href : undefined;

// The social preview: the dedicated image, or the book cover when settings has none.
const socialSource = resolveImage(settings.social_image);
const social = socialSource
  ? await getImage({ src: socialSource, width: 1200, format: 'jpg', quality: 82 })
  : undefined;
const socialUrl = social ? new URL(social.src, site).href : coverUrl;
const socialAlt = social ? settings.social_image_alt : book.cover_alt;

const publisher = book.publisher || undefined;
const awardName = [plainText(award.title), award.competition].filter(Boolean).join(' – ') || undefined;
const personId = `${site.href}#roberta`;
// The same first link the book section shows: one with both a label and an address.
const purchaseUrl = book.purchase_links.find((link) => link.label && link.url)?.url || undefined;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: settings.name,
      jobTitle: 'Autrice',
      url: site.href,
      sameAs: [settings.instagram].filter(Boolean),
      award: awardName,
    },
    {
      '@type': 'Book',
      name: book.title,
      author: { '@id': personId },
      isbn: book.isbn || undefined,
      inLanguage: 'it',
      genre: 'Fiaba illustrata',
      typicalAgeRange: '3-',
      award: awardName,
      image: coverUrl,
      publisher: publisher ? { '@type': 'Organization', name: publisher } : undefined,
      url: purchaseUrl,
    },
  ],
};
// "<" escaped, so no text from the CMS can close the script element.
const jsonLd = JSON.stringify(structuredData).replace(/</g, '\\u003c');

// Mirrors --color-cream: a meta tag cannot read a CSS custom property.
const themeColor = '#faf7f2';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {(noindex || !isIndexable) && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    {/* The name in the opening is set in this face: fetched early so it does not swap late. */}
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {socialUrl && <meta property="og:image" content={socialUrl} />}
    {socialUrl && socialAlt && <meta property="og:image:alt" content={socialAlt} />}
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#content">Vai al contenuto</a>
    <Header />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  /*
   * Motion for the whole site (DES-07): reveals on scroll, and Lenis for inertial scrolling.
   * With reduced motion the CSS shows everything at once and Lenis never starts.
   */
  import Lenis from 'lenis';
  import 'lenis/dist/lenis.css';

  const root = document.documentElement;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Reveals: each [data-reveal] becomes .is-visible once, when it enters the view.
  const targets = document.querySelectorAll('[data-reveal]');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    );
    targets.forEach((target) => observer.observe(target));
  } else {
    targets.forEach((target) => target.classList.add('is-visible'));
  }
  root.classList.add('reveal-ready');

  // Whatever takes focus is shown at once, with everything around it, even outside the reveal area.
  document.addEventListener('focusin', (event) => {
    let element = (event.target as Element).closest('[data-reveal]');
    while (element) {
      element.classList.add('is-visible');
      element = element.parentElement?.closest('[data-reveal]') ?? null;
    }
  });

  if (!reducedMotion) {
    const lenis = new Lenis({ autoRaf: true });
    // Exposed for the header, which pauses it while the menu is open.
    Object.assign(window, { lenis });

    /*
     * Links to a section of this page glide there with Lenis, then move focus to the section
     * (it has tabindex="-1"), as a native jump would, so the next Tab continues from there.
     * Without Lenis the browser's own jump does all of this.
     */
    document.addEventListener('click', (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey) return;
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
      if (!link || link.target) return;
      const url = new URL(link.href);
      if (url.origin !== location.origin || url.pathname !== location.pathname || !url.hash) return;
      const target = document.getElementById(decodeURIComponent(url.hash.slice(1)));
      if (!target) return;

      event.preventDefault();
      history.pushState(null, '', url.hash);
      // The browser may have scrolled on its own (focus moving): start from where the page really is.
      lenis.scrollTo(window.scrollY, { immediate: true, force: true });
      // Lenis reads scroll-padding-top itself, so the section lands clear of the sticky header.
      lenis.scrollTo(target);
      target.focus({ preventScroll: true });
    });
  }
</script>
