---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import SimplePage from '../components/SimplePage.astro';
import { longDate } from '../lib/dates';

const page = await getEntry('pages', 'privacy');
if (!page) throw new Error('Missing src/content/pages/privacy.md');
const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.description || undefined} noindex>
  <SimplePage title={page.data.title}>
    {page.data.updated && <p class="updated">Ultimo aggiornamento: {longDate(page.data.updated)}</p>}
    <Content />
  </SimplePage>
</Base>

<style>
  .updated {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>
